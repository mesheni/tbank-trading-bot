# Токен T-Invest API (получить: https://www.tbank.ru/invest/open-api → «Подключить»)
# Для sandbox достаточно токена с доступом к песочнице.
# ВНИМАНИЕ: настоящий токен вписывайте в .env (он в .gitignore), а не в этот шаблон!
T_INVEST_TOKEN=

# Режим работы: sandbox | real  (реальный счёт требует отдельного явного включения)
MODE=sandbox

# Инструменты для торговли (тикеры MOEX, доска TQBR)
# Рекомендованный ликвидный набор (нефтегаз, металлы, техно/телеком/ретейл, транспорт, биржа):
TICKERS=SBER,GAZP,LKOH,ROSN,NVTK,TATN,GMKN,PLZL,CHMF,ALRS,YDEX,MTSS,MGNT,OZON,AFLT,MOEX
# Минимальный набор: TICKERS=SBER,GAZP,LKOH

# Горизонт прогноза, в барах рабочего таймфрейма (например, 1 час при CANDLE_INTERVAL_HOUR)
FORECAST_HORIZON=1

# Таймфрейм выгрузки/торговли: 1min | 5min | 15min | hour | day
CANDLE_INTERVAL=hour

# --- Режим работы по размеру капитала (профиль) ---
# auto — бот сам определит режим по фактическому капиталу счёта при старте;
# либо зафиксируйте вручную: micro (10–50 тыс.) | small (50–200 тыс.) | standard (200 тыс.+)
#   micro:    позиция до 100% капитала, экспозиция до 100% (1–2 дешёвых лота)
#   small:    позиция до 35%, экспозиция до 90%
#   standard: позиция до 20%, экспозиция до 80% (как в MAX_POSITION_PCT ниже)
# Профиль действует ТОЛЬКО на параметры, не заданные явно в .env:
# закомментированные MAX_POSITION_PCT/MAX_TOTAL_EXPOSURE_PCT дают профилю
# управлять ими; раскомментированные значения сильнее профиля.
CAPITAL_PROFILE=auto
#MAX_POSITION_PCT=0.20
#MAX_TOTAL_EXPOSURE_PCT=0.8

# Лимит совокупной стоимости ВСЕХ позиций к портфелю (0..1, none — без лимита).
# Режет корреляционные кластеры: 5 позиций по 20% — это уже 100% рынка в лонге.
# (см. MAX_TOTAL_EXPOSURE_PCT в блоке профиля выше)

# Бюджет счёта, руб — якорь kill-switch и P&L. По умолчанию SANDBOX_INITIAL_RUB
# (sandbox) или фактический капитал счёта (real). Задайте явно, например 30000,
# чтобы просадка считалась от реального размера счёта, а не от миллиона.
#ACCOUNT_BUDGET_RUB=30000

# Kill-switch по просадке: при капитале ниже бюджета*(1-порог) новые входы
# запрещаются до перезапуска бота (стопы/тейки продолжают работать).
MAX_DRAWDOWN_PCT=0.15

# Стоп-лосс / тейк-профит по позиции, доли (0.03 = 3%)
STOP_LOSS_PCT=0.03
TAKE_PROFIT_PCT=0.05

# Порог |прогнозной доходности| для входа, доли за горизонт.
# Итоговый порог = max(этого значения, рекомендация модели из train, которая
# не опускается ниже издержек за круг ~2*(комиссия+проскальзывание)).
# Компромисс: ниже порог — больше сделок и больше съедает комиссия;
# выше — реже сделки. При hourly-горизонте разумный диапазон 0.002-0.005.
MIN_ABS_RETURN=0.004

# Выход «прогноз развернулся»: во сколько раз порог выхода шире входного.
# 1 = симметрично входу (частые перевороты -> churn на издержках);
# 2 = держим позицию при слабых отрицательных колебаниях прогноза.
REVERSAL_EXIT_MULT=2.0

# Гейт качества модели для live: новые входы только если directional accuracy
# модели на walk-forward тесте >= порога. Незамеренная (NaN) точность тоже блокирует.
# 0.5 = монета; защищает от торговли бейзлайнами вроде persistence без преимущества.
MIN_MODEL_DIR_ACC=0.5

# Комиссия тарифа за сделку, доли (0.0004 = 0.04% за сторону сделки).
# Используется в бэктесте и для оценки комиссии в отчёте cli.py report.
COMMISSION_PCT=0.0004

# Минимальная комиссия брокера за заявку, руб (0 — не учитывать).
# У некоторых тарифов есть нижний порог комиссии за сделку — на малых суммах
# (10–50 тыс.) он заметно влияет на экономику круга.
COMMISSION_MIN_RUB=0

# Проскальзывание цены исполнения, доли (0.0002 = 0.02% за сторону, бэктест).
SLIPPAGE_PCT=0.0002

# Бюджет sandbox-счёта, руб (вносится один раз на пустой счёт; также бюджет
# для reset-sandbox/normalize, если не задан ACCOUNT_BUDGET_RUB).
#SANDBOX_INITIAL_RUB=1000000

# Новостной фильтр: не открывать лонг при sentiment-score ниже порога (окно 48ч)
NEWS_SENTIMENT_GATE=-0.35

# --- NLP-контур (см. DEPLOY.md §3.7) ---
# Модель тональности: базовая ruBERT (~700 МБ RAM) или облегчённая (~30 МБ, для VPS с 1-2 ГБ):
# SENTIMENT_MODEL=cointegrated/rubert-tiny-sentiment-balanced
# Тональность: auto (трансформер, если стоит torch+transformers, иначе лексикон) | lexicon | transformer
NLP_SENTIMENT=auto
# Эмбеддеры повестки: 0 отключает (экономит ~450 МБ RAM, без кластеризации тем)
NLP_EMBEDDER=1

# Интервал цикла бота, секунды
LOOP_INTERVAL_SEC=300

# Автоперевод отклонённой лимитной заявки (HTTP 400) в рыночную.
# Для sandbox удобно (заявки всегда проходят), для MODE=real рекомендовано 0:
# невалидная цена не должна превращаться в сделку по неожидаемой цене.
ORDER_FALLBACK_TO_MARKET=1

# Пути
DB_PATH=data/market.sqlite
MODELS_DIR=models_artifacts
REPORTS_DIR=reports

# --- Уведомления по email (SMTP, см. notify.py) ---
# Telegram из РФ недоступен, канал — обычная почта (Яндекс/Mail.ru, пароль приложения).
# Пустой NOTIFY_EMAIL_TO отключает письма; бот продолжает работать.
# NOTIFY_EMAIL_TO=trader@example.com
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_USER=trader@yandex.ru
# SMTP_PASSWORD=пароль-приложения
# SMTP_FROM=trader@yandex.ru

# --- TLS-сертификаты (НУЦ Минцифры) ---
# По умолчанию клиент сам подхватывает .cer/.crt/.pem из корня проекта и папки certs/.
# Можно указать свой файл или папку с сертификатами явно:
# T_INVEST_CA_BUNDLE=C:\certs\russian_trusted_root_ca.pem
# Последний ресурс для диагностики: отключить проверку TLS вовсе (НЕБЕЗОПАСНО!):
# TLS_INSECURE=1
